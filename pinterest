// ── SPOTS SYSTEM ──────────────────────────────
// Fresh visitor → random 11–14 spots
// Same visitor within 8 hours → same number persists
// Every 3–7 minutes in-session → quietly decrements by 1
const SK = 'pinprofit_v5';
const TOTAL = 100;

function loadSpots() {
  try {
    const raw = localStorage.getItem(SK);
    if (raw) {
      const d = JSON.parse(raw);
      const hrs = (Date.now() - d.ts) / 3600000;
      if (hrs < 8 && d.s >= 4) return d.s;
    }
  } catch(e) {}
  const s = Math.floor(Math.random() * 4) + 11; // 11–14
  saveSpots(s);
  return s;
}
function saveSpots(s) {
  try { localStorage.setItem(SK, JSON.stringify({s, ts: Date.now()})); } catch(e) {}
}

let spots = loadSpots();

function renderSpots() {
  const taken = TOTAL - spots;
  const pct = (taken / TOTAL * 100).toFixed(1);
  // Numbers
  ['tick-spots','nav-spots','final-spots','fb-spots'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.textContent = spots;
  });
  const hsb = document.getElementById('hero-spots-b');
  if (hsb) hsb.textContent = spots + ' spots';
  ['pb-taken','sv-taken'].forEach(id => { const el=document.getElementById(id); if(el) el.textContent=taken; });
  ['pb-left','sv-left'].forEach(id => { const el=document.getElementById(id); if(el) el.textContent=spots; });
  // Bars
  ['prog-fill','slot-bar'].forEach(id => { const el=document.getElementById(id); if(el) el.style.width=pct+'%'; });
}
renderSpots();

// Slow session decrement
function scheduleDecrement() {
  const delay = Math.floor(Math.random() * 240000) + 180000; // 3–7 min
  setTimeout(() => {
    if (spots > 4) { spots--; saveSpots(spots); renderSpots(); }
    scheduleDecrement();
  }, delay);
}
scheduleDecrement();

