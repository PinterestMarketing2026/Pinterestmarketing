<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Get Your First Pinterest Sale in 7 Days — Guaranteed</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;600;700&family=Syne:wght@700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --red:#E60023;--red-dark:#ad081b;--red-light:#fff0f2;
  --cream:#FFF8F4;--warm:#FFFCFA;
  --dark:#111;--mid:#444;--light:#888;
  --gold:#D4880A;--gold-bg:#FFF8E1;--gold-border:rgba(212,136,10,.3);
  --green:#0A8F42;--green-bg:#F0FBF4;--green-border:#b2e8c8;
  --border:#EDE5DE;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:'DM Sans',sans-serif;background:var(--warm);color:var(--dark);overflow-x:hidden;-webkit-font-smoothing:antialiased;}

/* ── TICKER ── */
.ticker{background:#1a1a1a;color:#fff;padding:9px 16px;font-size:13px;font-weight:500;display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;text-align:center;}
.t-hl{color:#ffd166;font-weight:800;}
.t-badge{display:inline-flex;align-items:center;gap:5px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:50px;padding:2px 10px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;white-space:nowrap;}
.gdot{width:6px;height:6px;border-radius:50%;background:#2ecc71;animation:pulse 1.4s infinite;flex-shrink:0;}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.6)}}

/* ── NAV ── */
nav{background:#fff;border-bottom:1.5px solid var(--border);padding:11px 20px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:200;box-shadow:0 2px 14px rgba(0,0,0,.07);}
.logo{display:flex;align-items:center;gap:9px;font-family:'Syne',sans-serif;font-size:17px;font-weight:900;color:var(--dark);text-decoration:none;letter-spacing:-.3px;}
.picon{width:30px;height:30px;background:var(--red);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-family:'Syne',sans-serif;font-size:16px;font-weight:900;flex-shrink:0;}
.nav-r{display:flex;align-items:center;gap:12px;}
.nav-live{font-size:12px;color:var(--mid);display:flex;align-items:center;gap:5px;white-space:nowrap;}
.nav-cta{background:var(--red);color:#fff;padding:9px 20px;border-radius:50px;font-size:13px;font-weight:700;text-decoration:none;white-space:nowrap;transition:background .2s,box-shadow .2s;}
.nav-cta:hover{background:var(--red-dark);box-shadow:0 4px 14px rgba(230,0,35,.4);}

/* ── PROGRESS BAR ── */
.prog-strip{background:#fff;border-bottom:1px solid var(--border);padding:9px 20px;}
.prog-inner{max-width:680px;margin:0 auto;}
.prog-labels{display:flex;justify-content:space-between;font-size:12px;font-weight:700;margin-bottom:5px;}
.prog-labels .pl-taken{color:var(--red);}
.prog-labels .pl-left{color:var(--mid);}
.prog-track{height:9px;background:#f0e4dc;border-radius:50px;overflow:hidden;}
.prog-fill{height:100%;border-radius:50px;background:linear-gradient(90deg,#b0001a,var(--red));transition:width 1s ease;}

/* ── HERO ── */
.hero{padding:56px 20px 40px;text-align:center;background:linear-gradient(168deg,#fff4f5 0%,#fff9f3 50%,#fffcfa 100%);position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;width:800px;height:800px;border-radius:50%;background:radial-gradient(circle,rgba(230,0,35,.04) 0%,transparent 65%);top:-320px;left:50%;transform:translateX(-50%);pointer-events:none;}

.eyebrow{display:inline-flex;align-items:center;gap:7px;background:var(--gold-bg);border:1px solid var(--gold-border);color:#8a5c00;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1.1px;padding:6px 15px;border-radius:50px;margin-bottom:24px;}

.hero h1{font-family:'Playfair Display',serif;font-size:clamp(32px,7.5vw,64px);font-weight:900;line-height:1.08;max-width:800px;margin:0 auto 10px;color:var(--dark);}
.hero h1 em{color:var(--red);font-style:normal;}
.hero h1 u{text-decoration:underline;text-decoration-color:var(--red);text-decoration-thickness:3px;text-underline-offset:4px;}

.hero-promise{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1.5px solid var(--green-border);border-radius:10px;padding:10px 18px;margin:16px auto 20px;font-size:14px;font-weight:700;color:var(--green);}
.hp-check{font-size:18px;}

.hero-sub{font-size:clamp(15px,2.2vw,18px);color:var(--mid);max-width:560px;margin:0 auto 32px;line-height:1.72;}
.hero-sub strong{color:var(--dark);font-weight:700;}

/* PRICE CARD */
.pcard{background:#fff;border:2.5px solid var(--red);border-radius:24px;padding:32px 26px 26px;max-width:410px;margin:0 auto 30px;box-shadow:0 10px 54px rgba(230,0,35,.16);position:relative;}
.pcard-ribbon{position:absolute;top:-15px;left:50%;transform:translateX(-50%);background:var(--red);color:#fff;font-size:11px;font-weight:800;letter-spacing:.8px;text-transform:uppercase;padding:5px 18px;border-radius:50px;white-space:nowrap;}
.price-row{display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:2px;}
.p-was{font-size:22px;color:#bbb;text-decoration:line-through;font-weight:500;}
.p-now{font-family:'Syne',sans-serif;font-size:62px;font-weight:900;color:var(--red);line-height:1;}
.p-save{text-align:center;font-size:13px;font-weight:700;color:var(--green);margin-bottom:16px;}

.live-pill{display:flex;align-items:center;gap:9px;background:var(--green-bg);border:1px solid var(--green-border);border-radius:12px;padding:11px 16px;margin-bottom:15px;}
.lp-text{font-size:13px;color:#0a6832;font-weight:600;line-height:1.4;}
.lp-text strong{display:block;font-size:15px;color:var(--green);}

.slots-wrap{margin-bottom:18px;}
.slots-meta{display:flex;justify-content:space-between;font-size:12px;font-weight:700;margin-bottom:6px;}
.slots-meta .sm-red{color:var(--red);}
.slot-track{height:10px;background:#f5ebe4;border-radius:50px;overflow:hidden;}
.slot-bar{height:100%;border-radius:50px;background:linear-gradient(90deg,#b0001a,#E60023);transition:width 1s ease;}

.cta{display:block;width:100%;background:var(--red);color:#fff;text-align:center;padding:18px 20px;border-radius:14px;font-size:17px;font-weight:800;text-decoration:none;transition:all .25s;box-shadow:0 5px 22px rgba(230,0,35,.4);position:relative;overflow:hidden;letter-spacing:.1px;}
.cta::after{content:'';position:absolute;top:0;left:-100%;width:55%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.14),transparent);animation:sheen 3s infinite;}
@keyframes sheen{to{left:160%;}}
.cta:hover{background:var(--red-dark);transform:translateY(-2px);box-shadow:0 9px 32px rgba(230,0,35,.48);}
.cta-trust{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:11px;font-size:12px;color:#aaa;flex-wrap:wrap;}
.cta-trust span{display:flex;align-items:center;gap:3px;}

/* PROOF PILLS */
.proof-row{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin-top:26px;}
.ppill{background:#fff;border:1px solid var(--border);border-radius:50px;padding:7px 15px;font-size:13px;color:var(--mid);font-weight:500;display:flex;align-items:center;gap:6px;box-shadow:0 2px 8px rgba(0,0,0,.05);}

/* ── RED STAT BAR ── */
.stat-bar{background:var(--red);padding:28px 20px;}
.stat-row{max-width:860px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;text-align:center;}
.stat-row .sn{font-family:'Syne',sans-serif;font-size:clamp(22px,4.5vw,40px);font-weight:900;color:#fff;line-height:1;}
.stat-row .sl{font-size:11px;color:rgba(255,255,255,.72);text-transform:uppercase;letter-spacing:.7px;margin-top:4px;}

/* ── 7-DAY PROMISE SECTION ── */
.promise-sec{background:#fff;padding:60px 20px;}
.ps-wrap{max-width:860px;margin:0 auto;}
.promise-box{background:linear-gradient(135deg,#fff4f5,#fff9f0);border:2px solid #fcc;border-radius:22px;padding:44px 36px;text-align:center;position:relative;overflow:hidden;}
.promise-box::before{content:'';position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(230,0,35,.04),transparent);top:-100px;right:-80px;pointer-events:none;}
.pb-day{font-family:'Syne',sans-serif;font-size:72px;font-weight:900;color:var(--red);line-height:1;margin-bottom:4px;}
.pb-day span{font-size:28px;vertical-align:super;}
.pb-label{font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:1.5px;color:#aaa;margin-bottom:20px;}
.pb-title{font-family:'Playfair Display',serif;font-size:clamp(22px,4vw,34px);font-weight:900;line-height:1.2;margin-bottom:16px;color:var(--dark);}
.pb-title em{color:var(--red);font-style:normal;}
.pb-desc{font-size:15px;color:var(--mid);line-height:1.75;max-width:560px;margin:0 auto 28px;}
.pb-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;text-align:left;margin-top:24px;}
.pb-step{background:#fff;border:1px solid var(--border);border-radius:14px;padding:16px 18px;}
.pb-step .step-day{font-family:'Syne',sans-serif;font-size:11px;font-weight:900;color:var(--red);text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px;}
.pb-step p{font-size:13px;color:var(--mid);line-height:1.55;}
.pb-step strong{color:var(--dark);font-weight:700;}

/* ── GENERAL SECTIONS ── */
section{padding:60px 20px;}
.sw{max-width:880px;margin:0 auto;}
.tag{display:inline-block;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:1.5px;color:var(--red);margin-bottom:10px;}
.sh{font-family:'Playfair Display',serif;font-size:clamp(24px,5vw,40px);font-weight:900;line-height:1.15;margin-bottom:14px;}
.sh em{color:var(--red);font-style:normal;}
.sp{font-size:16px;color:var(--mid);line-height:1.72;max-width:600px;}

/* WHO */
.sec-cream{background:var(--cream);}
.sec-white{background:#fff;}
.who-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:32px;}
.wc{background:#fff;border-radius:16px;padding:22px;border:1px solid var(--border);position:relative;overflow:hidden;transition:transform .22s,box-shadow .22s;}
.wc:hover{transform:translateY(-3px);box-shadow:0 10px 28px rgba(0,0,0,.09);}
.wc::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--red);}
.we{font-size:28px;margin-bottom:10px;}
.wc h3{font-size:15px;font-weight:700;margin-bottom:7px;}
.wc p{font-size:13px;color:var(--mid);line-height:1.6;}

/* SOCIAL PROOF BAR */
.sp-bar{background:var(--dark);padding:22px 20px;}
.sp-bar-inner{max-width:880px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:32px;flex-wrap:wrap;}
.spb-item{display:flex;align-items:center;gap:10px;color:#fff;}
.spb-icon{font-size:22px;}
.spb-text strong{display:block;font-size:16px;font-weight:800;}
.spb-text span{font-size:11px;color:#888;text-transform:uppercase;letter-spacing:.7px;}
.spb-div{width:1px;height:32px;background:#333;}

/* PAIN */
.pain-list{margin-top:28px;display:flex;flex-direction:column;gap:10px;}
.pi{display:flex;align-items:flex-start;gap:14px;background:#fff4f5;border:1px solid #ffd5d8;border-radius:13px;padding:15px 18px;}
.pi-x{font-size:18px;flex-shrink:0;margin-top:1px;}
.pi-t{font-size:14px;color:var(--mid);line-height:1.6;}
.pi-t strong{color:var(--dark);font-weight:700;}
.sol-box{margin-top:28px;background:linear-gradient(135deg,#f0fbf4,#fff9f0);border:1.5px solid var(--green-border);border-radius:16px;padding:28px;text-align:center;}
.sol-box p{font-size:16px;line-height:1.75;color:var(--dark);}
.sol-box strong{color:var(--green);}

/* INSIDE */
.inside-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:14px;margin-top:34px;}
.ic{background:#fff;border-radius:18px;padding:24px;border:1px solid var(--border);transition:transform .2s,box-shadow .2s;position:relative;}
.ic:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(0,0,0,.09);}
.ic-num{font-family:'Syne',sans-serif;font-size:11px;font-weight:900;color:var(--red);text-transform:uppercase;letter-spacing:1px;margin-bottom:9px;}
.ic h3{font-size:15px;font-weight:700;margin-bottom:8px;line-height:1.3;color:var(--dark);}
.ic p{font-size:13px;color:var(--mid);line-height:1.62;}
.ic-tag{display:inline-block;margin-top:11px;background:var(--gold-bg);color:#8a5c00;font-size:11px;font-weight:700;padding:3px 10px;border-radius:50px;}

/* NICHES */
.sec-dark{background:var(--dark);}
.sec-dark .sh{color:#fff;}
.sec-dark .sp{color:#999;}
.niche-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:10px;margin-top:30px;}
.np{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:11px;padding:13px 14px;color:#ddd;font-size:13px;font-weight:500;display:flex;align-items:center;gap:9px;transition:all .2s;}
.np:hover{background:rgba(230,0,35,.18);border-color:var(--red);color:#fff;}
.niche-note{margin-top:22px;background:rgba(212,136,10,.1);border:1px solid var(--gold-border);border-radius:12px;padding:14px 18px;color:#e8a020;font-size:13px;font-weight:600;text-align:center;}

/* ROADMAP */
.weeks{margin-top:36px;position:relative;display:flex;flex-direction:column;}
.weeks::before{content:'';position:absolute;left:28px;top:0;bottom:0;width:2px;background:var(--border);}
.week{display:flex;gap:22px;align-items:flex-start;padding-bottom:32px;}
.wk-circle{width:56px;height:56px;border-radius:50%;background:var(--red);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;position:relative;z-index:2;box-shadow:0 4px 14px rgba(230,0,35,.3);font-family:'Syne',sans-serif;}
.wk-circle .wlabel{font-size:8px;font-weight:900;text-transform:uppercase;letter-spacing:.5px;opacity:.8;}
.wk-circle .wnum{font-size:20px;font-weight:900;line-height:1;}
.wk-body{padding-top:8px;flex:1;}
.wk-body h3{font-size:16px;font-weight:700;margin-bottom:6px;}
.wk-body p{font-size:13px;color:var(--mid);line-height:1.65;}
.wk-mile{display:inline-flex;align-items:center;gap:6px;margin-top:9px;background:var(--gold-bg);border:1px solid var(--gold-border);border-radius:50px;padding:4px 12px;font-size:12px;color:#8a5c00;font-weight:700;}

/* TESTIMONIALS */
.testi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:16px;margin-top:34px;}
.tc{background:#fff;border-radius:18px;padding:24px;border:1px solid var(--border);transition:transform .2s,box-shadow .2s;}
.tc:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(0,0,0,.08);}
.tc-stars{color:#f59e0b;font-size:14px;letter-spacing:2px;margin-bottom:12px;}
.tc-text{font-size:14px;color:var(--mid);line-height:1.72;font-style:italic;margin-bottom:14px;border-left:3px solid var(--red);padding-left:14px;}
.tc-result{background:var(--green-bg);border:1px solid var(--green-border);border-radius:10px;padding:11px 14px;margin-bottom:14px;}
.tc-result strong{font-size:15px;color:#0a6832;font-weight:800;display:block;}
.tc-result span{font-size:12px;color:#2e8a56;font-weight:500;}
.tc-author{display:flex;align-items:center;gap:10px;}
.av{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-weight:900;font-size:13px;color:#fff;flex-shrink:0;}
.av1{background:linear-gradient(135deg,#ff6b6b,#c0392b);}
.av2{background:linear-gradient(135deg,#3498db,#1a5276);}
.av3{background:linear-gradient(135deg,#f39c12,#d35400);}
.av4{background:linear-gradient(135deg,#8e44ad,#6c3483);}
.av5{background:linear-gradient(135deg,#27ae60,#1e8449);}
.tc-info strong{font-size:13px;display:block;font-weight:700;}
.tc-info span{font-size:12px;color:var(--light);}
.tc-7day{display:inline-flex;align-items:center;gap:5px;margin-top:10px;background:#fff0f0;border:1px solid #fcc;border-radius:50px;padding:3px 10px;font-size:11px;font-weight:700;color:var(--red);}

/* GUARANTEE */
.guar-box{background:linear-gradient(135deg,#f9fff4,#fff9f0);border:2px solid var(--green-border);border-radius:22px;padding:44px 36px;text-align:center;max-width:640px;margin:0 auto;}
.gi{font-size:52px;margin-bottom:16px;}
.guar-box h2{font-family:'Playfair Display',serif;font-size:clamp(22px,4vw,32px);font-weight:900;margin-bottom:14px;color:var(--dark);}
.guar-box h2 em{color:var(--green);font-style:normal;}
.guar-box p{font-size:14px;color:var(--mid);line-height:1.8;}
.guar-chips{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin-top:20px;}
.gchip{background:#fff;border:1px solid var(--green-border);border-radius:50px;padding:6px 14px;font-size:12px;font-weight:700;color:var(--green);}

/* FAQ */
.faq-list{margin-top:32px;display:flex;flex-direction:column;gap:10px;}
.faq-item{background:#fff;border:1px solid var(--border);border-radius:14px;overflow:hidden;}
.faq-q{padding:17px 18px;font-weight:700;font-size:14px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:12px;user-select:none;line-height:1.4;}
.faq-icon{font-size:20px;color:var(--red);flex-shrink:0;transition:transform .3s;font-weight:300;line-height:1;}
.faq-item.open .faq-icon{transform:rotate(45deg);}
.faq-a{font-size:14px;color:var(--mid);line-height:1.72;max-height:0;overflow:hidden;transition:max-height .35s ease,padding .35s;}
.faq-item.open .faq-a{max-height:320px;padding:0 18px 18px;}

/* ── FINAL CTA ── */
.final-sec{background:var(--dark);padding:76px 20px;text-align:center;}
.final-sec h2{font-family:'Playfair Display',serif;font-size:clamp(28px,5.5vw,50px);font-weight:900;color:#fff;line-height:1.12;margin-bottom:12px;}
.final-sec h2 em{color:#ffd166;font-style:normal;}
.final-sec .fsub{display:block;color:#888;font-size:15px;margin-bottom:36px;max-width:480px;margin-left:auto;margin-right:auto;}
.fpb{max-width:350px;margin:0 auto 20px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:24px;}
.fpb-row{display:flex;align-items:center;justify-content:center;gap:12px;}
.fpb-was{color:#555;font-size:20px;text-decoration:line-through;}
.fpb-now{font-family:'Syne',sans-serif;font-size:56px;font-weight:900;color:#fff;line-height:1;}
.fpb-save{color:#ffd166;font-size:13px;font-weight:700;margin-top:6px;}
.final-live{display:flex;align-items:center;justify-content:center;gap:7px;color:#666;font-size:13px;margin-bottom:26px;}
.final-live .fsn{color:#fff;font-weight:800;}
.cta-lg{display:inline-block;background:var(--red);color:#fff;padding:19px 46px;border-radius:14px;font-size:18px;font-weight:800;text-decoration:none;transition:all .25s;box-shadow:0 5px 26px rgba(230,0,35,.45);}
.cta-lg:hover{background:var(--red-dark);transform:translateY(-2px);box-shadow:0 10px 36px rgba(230,0,35,.55);}
.trust-row{display:flex;justify-content:center;flex-wrap:wrap;gap:18px;margin-top:22px;}
.tr{color:#555;font-size:12px;display:flex;align-items:center;gap:4px;}
.tr b{color:#777;}

/* FOOTER */
footer{background:#0a0a0a;padding:24px;text-align:center;font-size:12px;color:#444;}
footer a{color:#555;text-decoration:none;}
footer a:hover{color:#888;}

/* MOBILE FLOAT BAR */
.fbar{display:none;position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:2px solid var(--red);padding:10px 16px;z-index:300;align-items:center;justify-content:space-between;gap:10px;box-shadow:0 -4px 20px rgba(0,0,0,.13);}
.fb-l{}
.fb-was{font-size:11px;color:#bbb;text-decoration:line-through;}
.fb-price{font-family:'Syne',sans-serif;font-size:24px;font-weight:900;color:var(--red);line-height:1.1;}
.fb-spots{font-size:11px;color:var(--green);font-weight:700;display:flex;align-items:center;gap:4px;}
.fb-dot{width:5px;height:5px;background:var(--green);border-radius:50%;animation:pulse 1.4s infinite;}
.fb-cta{background:var(--red);color:#fff;padding:13px 20px;border-radius:12px;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;}
